# Telegram @BotFather token. Required for local runs and GitHub Actions.
TELEGRAM_BOT_TOKEN=

# OpenCode Zen is a user-provided token: users add their own tokens in Telegram.
# Do not put OpenCode user tokens in this file.
OPENCODE_ZEN_BASE_URL=https://opencode.ai/zen/v1

# Required for encrypted state persistence. Generate locally with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
STATE_ENCRYPTION_KEY=

# GitHub Actions sets these automatically. They enable encrypted state and
# generated-project commits in the repository.
GITHUB_TOKEN=
GITHUB_REPOSITORY=

# Optional local fallback when GITHUB_TOKEN/GITHUB_REPOSITORY are absent.
STATE_FILE=data/state.enc

# Optional: comma-separated Telegram user IDs for operational notices.
ADMIN_USER_IDS=

# Session length is intentionally below GitHub's six-hour schedule interval.
SESSION_MINUTES=350